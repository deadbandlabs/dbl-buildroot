# Consent session (dbl.consent=1, set by the consent U-Boot):
# /var is an overlay with a tmpfs upper dir instead of the data volume,
# so data from earlier boots can't affect a consent session

[Unit]
Description=Consent Boot volatile /var
DefaultDependencies=no
ConditionKernelCommandLine=dbl.consent=1
Before=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mkdir -p /run/consent-var/upper /run/consent-var/work
ExecStart=/bin/mount -t overlay -o noexec,nosuid,nodev,lowerdir=/var,upperdir=/run/consent-var/upper,workdir=/run/consent-var/work overlay /var

[Install]
WantedBy=local-fs.target
