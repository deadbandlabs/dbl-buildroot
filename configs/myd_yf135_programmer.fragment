# Programmer variant overrides on top of myd_yf135_defconfig
# Merged for MODE=programmer (Makefile) and nix image build (nix/build.nix)

BR2_PACKAGE_DBL_OTP_WRITE=y
BR2_PACKAGE_DBL_CONSENT=y
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MYD_YF135_PATH)/board/myd-yf135/uboot-programmer.fragment"
