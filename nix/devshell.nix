# Development shell configurations.
{
  pkgs,
  buildroot,
  cmake-compat,
  certEnv ? "",
  # Downstream-injected packages added to the default shell
  extraPackages ? [ ],
  # Make builds in this shell use the prebuilt external-toolchain SDK (.#toolchain)
  # The Makefile resolves it per defconfig. No SDK dependency in the shell
  # false: make falls back to TOOLCHAIN_SDK=<path> or the internal toolchain
  nixToolchain ? true,
}:
let
  flashDfu = pkgs.writeShellApplication {
    name = "flash-dfu";
    runtimeInputs = with pkgs; [
      dfu-util
      gawk
      coreutils
    ];
    text = builtins.readFile ../support/flash-dfu.sh;
  };

  stm32Sign = pkgs.writeShellApplication {
    name = "stm32-sign";
    runtimeInputs = [ pkgs.openssl ];
    text = ''exec ${pkgs.python3}/bin/python3 ${../support/stm32-sign.py} "$@"'';
  };

  brShellHook = ''
    export BUILDROOT_SRC="${buildroot}"
    # For merge-defconfig.py, python3 stays out of `packages` (see brShellPackages)
    export DBL_PYTHON3="${pkgs.python3}/bin/python3"
    ${pkgs.lib.optionalString nixToolchain "export DBL_NIX_TOOLCHAIN=1"}
    # Buildroot rejects host cmake >= 4.0 and bootstraps host-cmake instead
    # Presetting BR2_CMAKE skips that check (cmake-compat covers the 4.x breaks)
    export BR2_CMAKE="${cmake-compat}/bin/cmake"
    ${certEnv}
  '';

  # Packages required to run Buildroot builds
  brShellPackages = with pkgs; [
    # Core build toolchain
    gcc
    binutils
    cmake-compat

    gnumake

    # Scripting / config
    # No python3 (Makefile gets one via DBL_PYTHON3)
    #   Buildroot builds its host Python
    #   Nix's gcc-wrapper injects include paths from all devShell packages via
    #   NIX_CFLAGS_COMPILE. python3 here would bleed 3.13 headers into the
    #   host-python-markupsafe C extension build, giving a cpython-313 SOABI tag
    #   that mismatches the running Python 3.12
    perl
    bison
    flex

    # Buildroot host dependencies (mirrors buildroot.nix FHS env)
    bc
    cpio
    file
    rsync
    unzip
    wget
    which
    util-linux
    libxcrypt
    pkg-config
    linux-pam # host-libcap pam_cap module needs security/pam_modules.h
    gnutls
    gnutls.dev # u-boot mkeficapsule needs gnutls/gnutls.h
    xxd # u-boot defaultenv_autogenerated.h (CONFIG_ENV_DEFAULT_ENV_TEXT_FILE)

    # ncurses for menuconfig / linux configurators
    ncurses
    ncurses.dev

    # Compression
    gzip
    lzop
    lz4

    # Device tree tooling
    dtc

    # CA certificates for wget/curl/git HTTPS (Nix wget has no system bundle)
    cacert

    # Source management
    git
    patch
    diffutils
    findutils
    gnugrep
    gnused
    gawk

    # Signing/secure-boot tooling
    openssl

    dfu-util
  ];

  # stdenv.cc.cc.lib provides libstdc++.so.6 / libgcc_s.so.1
  # Buildroot compiles patchelf with RUNPATH=$ORIGIN/../lib; that directory
  # doesn't hold these Nix-store libs, so we expose them via LD_LIBRARY_PATH.
  # libidn2 + libunistring: host-cmake links host-OS libcurl which pulls in
  # /usr/lib/libidn2.so / libunistring.so; both must be resolvable at
  # link time and runtime.
  brShellLibPath = pkgs.lib.makeLibraryPath [
    pkgs.stdenv.cc.cc.lib
    pkgs.libidn2
    pkgs.libunistring
  ];

  # hardeningDisable: Nix's GCC wrapper injects -Werror=format-security by
  #   default; Buildroot's host-gcc-initial (GCC 13) doesn't satisfy this in
  #   its own libcpp, so the host compiler build fails.
  brShellArgs = {
    hardeningDisable = [ "format" ];
    packages = brShellPackages;
    LD_LIBRARY_PATH = brShellLibPath;
    shellHook = brShellHook;
  };
in
{
  default = pkgs.mkShell (
    brShellArgs
    // {
      name = "dbl-buildroot";
      packages =
        brShellArgs.packages
        ++ [
          # flash-dfu: flash a board over USB DFU (support/flash-dfu.sh)
          flashDfu
          # stm32-sign: sign STM32MP13 FSBL headers (support/stm32-sign.py)
          stm32Sign

          # act: run GitHub Actions workflows locally (via podman rootless)
          pkgs.act
          pkgs.podman

          # cachix: push cached nix build results (pulls are automatic)
          pkgs.cachix
        ]
        ++ extraPackages;
      shellHook = brShellArgs.shellHook + ''
        echo "DBL buildroot development shell"
        echo "  Buildroot: 2025.02 LTS"
        echo "  Target:    STM32MP135D (MYD-YF135-256N-256D)"
        echo ""
        echo "Common commands:"
        echo "  make                  # release image"
        echo "  make debug            # debug image"
        echo "  make menuconfig       # after a first build"
        echo "  flash-dfu             # flash via USB DFU"
        echo ""
        echo "Nix hermetic build:"
        echo "  make nix-lock         # first time / after pkg version changes"
        echo "  nix build             # build image"
      '';
    }
  );

  ci = pkgs.mkShell (brShellArgs // { name = "dbl-buildroot-ci"; });

  pre-commit = pkgs.mkShell {
    name = "dbl-pre-commit";
    packages = with pkgs; [
      pre-commit
      git
      reuse
      shellcheck
      shfmt
      yamllint
      nixfmt-rfc-style
      perl
      gnutar
      mdformat
      commitizen
      python3
    ];

    shellHook = ''
      export PRE_COMMIT_HOME="''${OUTPUT_BASE:-$PWD}/.cache/pre-commit"
      echo "DBL pre-commit shell"
      echo "  Cache: $PRE_COMMIT_HOME"
    '';
  };
}
